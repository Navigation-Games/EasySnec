export struct Course {
    name: string,
    checkpoints: [int]
}

export struct CourseSet {
    name: string,
    enabled: bool,
    courses: [Course]
}

export enum MistakeType {missed, shuffle, no-start, no-finish}
export enum ResultType {success, fail} // might need more options

export struct Mistake {
    type: MistakeType,
    checkpoint: int,
}
export struct Grade {
    mistakes: [Mistake],
    result: string,
    course: string,
    time: string,
}

export enum GuiState {
    settings,running,editor
}

// namespace for shared functions that slint doesnt have, for whatever reason
// unfortunately these are typed.
export global Utils {
    pure callback find(array:[string], value: string) -> int;
    pure callback course_to_string(course: [int]) -> string;
    pure callback string_to_course(string) -> [int];
    pure callback try_update_course(course:[int], update:string) -> [int];
}
